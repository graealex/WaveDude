<UserControl x:Class="WaveDudeNext.WPF.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaveDudeNext.WPF.Views"
             xmlns:controls="clr-namespace:WaveDudeNext.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDudeNext.WPF.Markup"
             xmlns:model="clr-namespace:WaveDudeNext.Model;assembly=WaveDudeNext">

	<UserControl.CommandBindings>
		<CommandBinding Command="{x:Static local:ProjectView.Reseed}" Executed="OnReseed" />
	</UserControl.CommandBindings>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<Label Style="{StaticResource FormSection}" Content="{DynamicResource SectionGeneral}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Project.Version}" />
				<TextBlock Style="{StaticResource FormValue}" Text="{Binding Version}" ToolTip="{meta:Hint model:Project.Version}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Project.Seed}" />
				<DockPanel>
					<Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{DynamicResource ButtonNewSeed}"
					        Command="{x:Static local:ProjectView.Reseed}" />
					<controls:NumberBox Text="{Binding Seed}" ToolTip="{meta:Hint model:Project.Seed}" />
				</DockPanel>

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Project.Description}" VerticalAlignment="Top" Margin="0,4,0,0" />
				<TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ToolTip="{meta:Hint model:Project.Description}"
				         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top"
				         VerticalScrollBarVisibility="Auto" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
