<Project Sdk="Microsoft.NET.Sdk">

  <!-- Verification harness for the WaveDude library (engines, probes, rendering, frame store, run driver).
       Not part of the solution; run with "dotnet run" on this project (Release) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows with WPF, for the bench of the WIC JPEG encoder (the library itself stays net10.0) -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LibraryCheck</RootNamespace>
  </PropertyGroup>

  <!-- UseWPF drops System.IO from the implicit usings -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WaveDude\WaveDude.csproj" />
  </ItemGroup>

</Project>
