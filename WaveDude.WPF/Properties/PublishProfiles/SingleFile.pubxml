<?xml version="1.0" encoding="utf-8"?>
<!-- Single-file, framework-dependent publish for 64-bit Windows: one WaveDude.WPF.exe plus the ColorSchemeList
     folder (copied by the csproj) in bin\Publish. The framework comes from the project.
     dotnet publish WaveDude.WPF/WaveDude.WPF.csproj -p:PublishProfile=SingleFile -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Publish\</PublishDir>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
