<UserControl x:Class="WaveDude.WPF.Views.ProbeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDude.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDude.WPF.Markup"
             xmlns:converters="clr-namespace:WaveDude.WPF.Converters"
             xmlns:model="clr-namespace:WaveDude.Model;assembly=WaveDude">

	<UserControl.Resources>
		<converters:MeasurementsForLayerConverter x:Key="MeasurementsForLayer" />
		<!-- point B and the step axis only apply to line and point probes respectively -->
		<Style x:Key="LineOnly" TargetType="{x:Type controls:NumberBox}" BasedOn="{StaticResource {x:Type controls:NumberBox}}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Kind}" Value="Point">
					<Setter Property="IsEnabled" Value="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="PointOnlyCombo" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource EnumComboBox}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Kind}" Value="Line">
					<Setter Property="IsEnabled" Value="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="PointOnlyCheck" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Kind}" Value="Line">
					<Setter Property="IsEnabled" Value="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionGeneral}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.Name}" />
				<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{meta:Hint model:Probe.Name}" />

				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:Probe.Active}"
				          IsChecked="{Binding Active}" ToolTip="{meta:Hint model:Probe.Active}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.StartAfter}" />
				<controls:NumberBox Text="{Binding StartAfter}" Minimum="0" ToolTip="{meta:Hint model:Probe.StartAfter}" />
			</controls:FormPanel>

			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionMeasurement}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.Layer}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:ProbeLayer}"
				          SelectedItem="{Binding Layer}" ToolTip="{meta:Hint model:Probe.Layer}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.Measurement}" />
				<!-- only the measurements the layer offers: amplitude for the field, value / integrated value for the intensity -->
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{Binding Layer, Converter={StaticResource MeasurementsForLayer}}"
				          SelectedItem="{Binding Measurement}" ToolTip="{meta:Hint model:Probe.Measurement}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.Kind}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:ProbeKind}"
				          SelectedItem="{Binding Kind}" ToolTip="{meta:Hint model:Probe.Kind}" />
			</controls:FormPanel>

			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionPosition}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.AX}" />
				<controls:NumberBox Text="{Binding AX}" Minimum="0" ToolTip="{meta:Hint model:Probe.AX}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.AY}" />
				<controls:NumberBox Text="{Binding AY}" Minimum="0" ToolTip="{meta:Hint model:Probe.AY}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.BX}" />
				<controls:NumberBox Style="{StaticResource LineOnly}" Text="{Binding BX}" Minimum="0" ToolTip="{meta:Hint model:Probe.BX}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.BY}" />
				<controls:NumberBox Style="{StaticResource LineOnly}" Text="{Binding BY}" Minimum="0" ToolTip="{meta:Hint model:Probe.BY}" />
			</controls:FormPanel>

			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionGraph}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.BoxSize}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:ProbeBoxSize}"
				          SelectedItem="{Binding BoxSize}" ToolTip="{meta:Hint model:Probe.BoxSize}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.BoxX}" />
				<controls:NumberBox Text="{Binding BoxX}" Minimum="0" ToolTip="{meta:Hint model:Probe.BoxX}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.BoxY}" />
				<controls:NumberBox Text="{Binding BoxY}" Minimum="0" ToolTip="{meta:Hint model:Probe.BoxY}" />
			</controls:FormPanel>

			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionAxes}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.ScaleMode}" />
				<ComboBox Style="{StaticResource PointOnlyCombo}" ItemsSource="{meta:EnumValues model:ProbeScaleMode}"
				          SelectedItem="{Binding ScaleMode}" ToolTip="{meta:Hint model:Probe.ScaleMode}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.Window}" />
				<controls:NumberBox Text="{Binding Window}" Minimum="10" Maximum="1000000" Increment="10" ToolTip="{meta:Hint model:Probe.Window}" />

				<CheckBox controls:FormPanel.FullWidth="True" Style="{StaticResource PointOnlyCheck}" Content="{meta:Label model:Probe.AutoScaleX}"
				          IsChecked="{Binding AutoScaleX}" ToolTip="{meta:Hint model:Probe.AutoScaleX}" />
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:Probe.AutoScaleY}"
				          IsChecked="{Binding AutoScaleY}" ToolTip="{meta:Hint model:Probe.AutoScaleY}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.YMin}" />
				<controls:NumberBox Text="{Binding YMin}" Increment="0.1" ToolTip="{meta:Hint model:Probe.YMin}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Probe.YMax}" />
				<controls:NumberBox Text="{Binding YMax}" Increment="0.1" ToolTip="{meta:Hint model:Probe.YMax}" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
