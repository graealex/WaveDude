<UserControl x:Class="WaveDude.WPF.Views.SceneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WaveDude.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDude.WPF.Markup"
             xmlns:model="clr-namespace:WaveDude.Model;assembly=WaveDude">

	<UserControl.Resources>
		<!-- the size applies to a blank canvas, the image path to an image scene -->
		<Style x:Key="CanvasOnly" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Mode}" Value="Image">
					<Setter Property="IsEnabled" Value="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="ImageOnly" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding Mode}" Value="Canvas">
					<Setter Property="IsEnabled" Value="False" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionCanvas}" />
			<controls:FormPanel>
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.Mode}" />
				<ComboBox Style="{StaticResource EnumComboBox}" ItemsSource="{meta:EnumValues model:SceneMode}"
				          SelectedItem="{Binding Mode}" ToolTip="{meta:Hint model:Scene.Mode}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.Image}" />
				<TextBox Style="{StaticResource ImageOnly}" Text="{Binding Image, UpdateSourceTrigger=PropertyChanged}" ToolTip="{meta:Hint model:Scene.Image}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.Width}" />
				<TextBox Style="{StaticResource CanvasOnly}" Text="{Binding Width}" ToolTip="{meta:Hint model:Scene.Width}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.Height}" />
				<TextBox Style="{StaticResource CanvasOnly}" Text="{Binding Height}" ToolTip="{meta:Hint model:Scene.Height}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.DampingEdge}" />
				<TextBox Text="{Binding DampingEdge}" ToolTip="{meta:Hint model:Scene.DampingEdge}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.RefractiveIndex}" />
				<TextBox Text="{Binding RefractiveIndex}" ToolTip="{meta:Hint model:Scene.RefractiveIndex}" />
			</controls:FormPanel>

			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionImageSources}" />
			<controls:FormPanel>
				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:Scene.ImageSources}"
				          IsChecked="{Binding ImageSources}" ToolTip="{meta:Hint model:Scene.ImageSources}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Scene.ImageSourceScale}" />
				<TextBox Text="{Binding ImageSourceScale}" IsEnabled="{Binding ImageSources}" ToolTip="{meta:Hint model:Scene.ImageSourceScale}" />

				<CheckBox controls:FormPanel.FullWidth="True" Content="{meta:Label model:Scene.ObjectSources}"
				          IsChecked="{Binding ObjectSources}" ToolTip="{meta:Hint model:Scene.ObjectSources}" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
