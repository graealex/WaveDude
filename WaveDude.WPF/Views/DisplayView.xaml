<UserControl x:Class="WaveDude.WPF.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaveDude.WPF.Views"
             xmlns:controls="clr-namespace:WaveDude.WPF.Controls"
             xmlns:meta="clr-namespace:WaveDude.WPF.Markup"
             xmlns:model="clr-namespace:WaveDude.Model;assembly=WaveDude">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="8">
			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionField}" />
			<local:DisplayLayerView DataContext="{Binding Field}" />

			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionIntensity}" />
			<local:DisplayLayerView DataContext="{Binding Intensity}" />

			<TextBlock Style="{StaticResource FormSection}" Text="{DynamicResource SectionVideo}" />
			<controls:FormPanel DataContext="{Binding Video}">
				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Video.Fps}" />
				<TextBox Text="{Binding Fps}" ToolTip="{meta:Hint model:Video.Fps}" />

				<TextBlock Style="{StaticResource FormLabel}" Text="{meta:Label model:Video.Quality}" />
				<TextBox Text="{Binding Quality}" ToolTip="{meta:Hint model:Video.Quality}" />
			</controls:FormPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
