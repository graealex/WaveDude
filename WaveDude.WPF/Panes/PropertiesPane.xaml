<UserControl x:Class="WaveDude.WPF.Panes.PropertiesPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WaveDude.WPF.Panes"
             xmlns:views="clr-namespace:WaveDude.WPF.Views"
             xmlns:converters="clr-namespace:WaveDude.WPF.Converters"
             xmlns:model="clr-namespace:WaveDude.Model;assembly=WaveDude">

	<!-- one view per model type; the content control picks the template by the selected object's type -->
	<UserControl.Resources>
		<DataTemplate DataType="{x:Type model:Project}">
			<views:ProjectView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type model:Scene}">
			<views:SceneView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type model:Simulation}">
			<views:SimulationView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type model:Display}">
			<views:DisplayView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type model:Source}">
			<views:SourceView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type model:Probe}">
			<views:ProbeView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type converters:NamedCollection}">
			<views:CollectionView />
		</DataTemplate>
	</UserControl.Resources>

	<Grid>
		<ContentControl Focusable="False"
		                Content="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType={x:Type local:PropertiesPane}}}" />
		<TextBlock Margin="6" Foreground="{DynamicResource GrayText}" Text="{DynamicResource NoSelection}">
			<TextBlock.Style>
				<Style TargetType="{x:Type TextBlock}">
					<Setter Property="Visibility" Value="Collapsed" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType={x:Type local:PropertiesPane}}}" Value="{x:Null}">
							<Setter Property="Visibility" Value="Visible" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</TextBlock.Style>
		</TextBlock>
	</Grid>
</UserControl>
