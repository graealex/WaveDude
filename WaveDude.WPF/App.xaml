<Application x:Class="WaveDude.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!-- colour table first (swapped at runtime by ThemeController), then the control styles -->
				<ResourceDictionary Source="Themes/Dark.xaml" />
				<ResourceDictionary Source="Themes/Controls.xaml" />
				<ResourceDictionary Source="Themes/Editors.xaml" />
				<ResourceDictionary Source="Themes/Lists.xaml" />
				<ResourceDictionary Source="Strings/Strings.EN.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>
