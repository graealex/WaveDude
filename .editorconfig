root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = tab
indent_size = 4

[*.{csproj,sln,resx,config,settings,manifest}]
indent_style = space
indent_size = 2

[*.{md,yml,yaml,json,py}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
