<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- every public member needs a /// comment; CS1591 flags the ones that lack it -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- optimised in every configuration: the engines' stencil loops run five times slower unoptimised, which
         makes the CPU engine unusable from a Debug build of the app; set to false locally to step through them -->
    <Optimize>true</Optimize>
    <!-- the MP4 writer copies a frame into a Media Foundation buffer through its raw pointer -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- read by About and the file properties; the licence text is LICENSE.md, the header of every source file names it -->
    <Authors>Alexander Graef</Authors>
    <Copyright>Copyright (C) 2026 Alexander Graef</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- the .editorconfig code-style rules are build warnings too: a file without the licence header (IDE0073) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- the shipped colour schemes are part of the binary; the ColorSchemes folder of this project is their source (2026-10-15: one file per scheme, named like the scheme, with spaces) -->
  <ItemGroup>
    <EmbeddedResource Include="ColorSchemes\*.wdscheme" LogicalName="ColorSchemes/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.1" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.12" />
  </ItemGroup>

</Project>
