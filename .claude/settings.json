{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.py\" record",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.py\" guard",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking for a git command the user did not ask for"
          }
        ]
      }
    ]
  }
}
