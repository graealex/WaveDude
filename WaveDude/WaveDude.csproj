<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- every public member needs a /// comment; CS1591 flags the ones that lack it -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- optimised in every configuration: the engines' stencil loops run five times slower unoptimised, which
         makes the CPU engine unusable from a Debug build of the app; set to false locally to step through them -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- the shipped colour schemes are part of the binary; the repo's ColorSchemeList folder is their source -->
  <ItemGroup>
    <EmbeddedResource Include="..\ColorSchemeList\*.wdscheme;..\ColorSchemeList\*.json" LogicalName="ColorSchemes/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.1" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.12" />
  </ItemGroup>

</Project>
